    "react-native-gesture-handler": "~2.32.0",
    "react-native-libsodium": "^1.7.0",
    "react-native-nitro-image": "^0.15.2",
    "react-native-nitro-modules": "^0.37.1",
    "react-native-qrcode-svg": "^6.3.26",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-vision-camera": "^5.2.3",
    "react-native-vision-camera-barcode-scanner": "^5.2.3",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.1",
    "zod": "^4.6.5"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "test": "jest",
    "bench": "jest --testMatch '**/__bench__/**/*.bench.js'",
    "e2e": "maestro test .maestro",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check"
  },
  "private": true,
  "devDependencies": {
    "babel-plugin-inline-import": "^3.0.0",
    "better-sqlite3": "^13.0.3",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.5",
    "libsodium-wrappers-sumo": "^0.8.4"
  },
  "jest": {
    "preset": "jest-expo",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/design/"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/jest/setup.js"
    ],
    "moduleNameMapper": {
      "^@automerge/automerge/automerge\\.wasm\\.base64\\.js$": "<rootDir>/jest/automergeWasmBase64.js",
      "^uuid$": "<rootDir>/../../node_modules/uuid/dist/index.js",
      "^react-native-libsodium$": "<rootDir>/jest/sodium.js"
    },
    "transformIgnorePatterns": [
      "/node_modules/(?!(.pnpm|react-native|@react-native|@react-native-community|expo|@expo|@expo-google-fonts|react-navigation|@react-navigation|@sentry/react-native|native-base|standard-navigation|@scure|@noble))",
      "/node_modules/react-native-reanimated/plugin/",
      "/node_modules/@react-native/babel-preset/"
    ]
  }
}
