# Copy to .env (not committed) for local runs; for EAS builds set the same names as
# environment variables of the project.

# The sync relay. Without it the app reaches ws://localhost:8787 (npm run server).
EXPO_PUBLIC_SYNC_URL=

# Crash and performance reports. Left empty, nothing is reported.
EXPO_PUBLIC_SENTRY_DSN=

# Only used at build time, to upload source maps.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
