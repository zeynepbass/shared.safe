{
  "name": "ortak-kasa-monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "mobile": "npm run start --workspace @ortak-kasa/mobile",
    "server": "npm run start --workspace @ortak-kasa/sync-server",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "prettier": "^3.9.9"
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "@shopify/react-native-skia@2.6.2": true,
    "better-sqlite3@13.0.3": true,
    "unrs-resolver@1.12.2": true,
    "react-native-libsodium@1.7.0": true,
    "fsevents": false
  }
}
